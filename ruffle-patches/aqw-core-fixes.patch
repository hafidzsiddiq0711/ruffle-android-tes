AQW/Skua fixes for Ruffle core, taken from VibeSkuffle v1.0.1 patches/skua.patch
(VibeSkuffle v1.0.1, patches/skua.patch, GPL-3.0). Applied by CI onto ruffle at the Cargo.lock commit.
- json.rs: Event objects stringify like Flash ({"params":...} for SFS packets, no target recursion),
           whole numbers without '.0'
- navigator.rs: connect/read timeouts so a hung login request fails instead of hanging

diff --git a/core/src/avm2/globals/json.rs b/core/src/avm2/globals/json.rs
--- a/core/src/avm2/globals/json.rs
+++ b/core/src/avm2/globals/json.rs
@@ -181,7 +181,20 @@
                 }
             }
         } else {
+            // Skua build: like Flash, an Event's built-in getters (type, target, ...) aren't
+            // written out; `target` would recurse into the whole dispatcher (AQW's SmartFox
+            // client). Flash gives `{"params":{...}}` for AQW's server packets.
+            let event_class = activation.avm2().classes().event.inner_class_definition();
+            let is_event = obj.is_of_type(event_class);
             for (name, val) in obj.public_vtable_properties(activation)? {
+                if is_event
+                    && matches!(
+                        name.to_utf8_lossy().as_ref(),
+                        "type" | "bubbles" | "cancelable" | "eventPhase" | "target" | "currentTarget"
+                    )
+                {
+                    continue;
+                }
                 let mapped = self.map_value(activation, || name, val)?;
                 if !skip_value(mapped) {
                     js_obj.insert(
@@ -237,6 +250,11 @@
             Value::Null => JsonValue::Null,
             Value::Undefined => JsonValue::Null,
             Value::Integer(i) => JsonValue::from(i),
+            // Skua build: like Flash, whole numbers are written without a fraction
+            // ("383618675", not "383618675.0"); values of 2^28 and up stay `Number`s.
+            Value::Number(n) if n.is_finite() && n.fract() == 0.0 && n.abs() < 9007199254740992.0 => {
+                JsonValue::from(n as i64)
+            }
             Value::Number(n) => JsonValue::from(n),
             Value::Bool(b) => JsonValue::from(b),
             Value::String(s) => JsonValue::from(s.to_utf8_lossy().deref()),
diff --git a/frontend-utils/src/backends/navigator.rs b/frontend-utils/src/backends/navigator.rs
